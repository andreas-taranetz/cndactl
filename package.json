{
  "name": "cndactl",
  "version": "0.1.0",
  "description": "Terminal UI and CLI for Cloud Native Days Austria",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "bin": {
    "cndactl": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andreas-taranetz/cndactl.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "prepare": "husky || true",
    "publish:dry-run": "pnpm publish --dry-run",
    "publish:release": "pnpm publish",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "link": "pnpm link --global",
    "unlink": "pnpm unlink --global"
  },
  "keywords": [
    "cloud-native",
    "conference",
    "cli",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "jimp": "^1.6.1",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "terminal-image": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
